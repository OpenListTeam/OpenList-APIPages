{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openlist-apis-page",
  "main": "src/cfapp.ts",
  "compatibility_date": "2025-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    // 公开服务建议填写正式回调域名；空值或默认占位符时自动推导，但不代表站点可信。
    // 仅在可信页面输入密钥/令牌，CORS 不能保护 URL 回调。详见 README 安全提醒。
    "MAIN_URLS": "api.example.com",
    "PROXY_API": "",
    "onedrive_uid": "*****************************",
    "onedrive_key": "*****************************",
    "alicloud_uid": "*****************************",
    "alicloud_key": "*****************************",
    "baiduyun_uid": "*****************************",
    "baiduyun_key": "*****************************",
    "baiduyun_ext": "*****************************",
    "cloud115_uid": "*****************************",
    "cloud115_key": "*****************************",
    "googleui_uid": "*****************************",
    "googleui_key": "*****************************",
    "yandexui_uid": "*****************************",
    "yandexui_key": "*****************************",
    "dropboxs_uid": "*****************************",
    "dropboxs_key": "*****************************",
    "quarkpan_uid": "*****************************",
    "quarkpan_key": "*****************************",
    "cloud123_uid": "*****************************",
    "cloud123_key": "*****************************",
    "cloud123_url": "*****************************"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
